{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "timezone": "Asia/Shanghai",
  "dependencyDashboard": true,
  "enabledManagers": ["github-actions", "npm", "gomod", "mise"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci",
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "description": "Keep npm ranges and pnpm lockfiles current.",
      "matchManagers": ["npm"],
      "groupName": "npm dependencies",
      "rangeStrategy": "bump",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Tidy Go modules after dependency updates.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect"],
      "groupName": "Go modules",
      "postUpdateOptions": ["gomodTidy"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group mise tool updates.",
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group Go toolchain updates.",
      "matchManagers": ["gomod", "mise"],
      "matchDepNames": ["go"],
      "groupName": "Go toolchain",
      "rangeStrategy": "bump",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Gate major updates through the dependency dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
